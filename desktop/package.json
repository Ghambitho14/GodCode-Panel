{
  "name": "godcode-caja",
  "productName": "GodCode Caja",
  "version": "1.0.0",
  "description": "App de escritorio del panel de GodCode: imprime los tickets directo, sin el diálogo del navegador.",
  "author": "Jhon Belandria",
  "private": true,
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "me.godcode-panel.caja",
    "productName": "GodCode Caja",
    "artifactName": "GodCode-Caja-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "GodCode Caja"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
