    "@radix-ui/react-tabs": "^1.1.16",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/postcss": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.12.29",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "3.9.1",
    "sileo": "^0.1.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
