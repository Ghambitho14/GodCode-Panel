{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app.tsx"],
  "project": ["src/**/*.{js,jsx,ts,tsx,css}", "tests/**/*.{js,jsx,ts,tsx}"],
  "ignoreDependencies": ["@vercel/node"],
  "ignoreExportsUsedInFile": true,
  "vite": {
    "config": ["vite.config.ts"]
  },
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["tests/**/*.{test,spec}.{js,jsx,ts,tsx}"]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/e2e/**/*.ts"]
  }
}
